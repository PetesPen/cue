{
  "name": "cue",
  "private": true,
  "version": "0.0.0",
  "description": "Cue: build and present 16:9 slide decks in the browser. Local-first, no server.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run size",
    "size": "node scripts/check-bundle-size.mjs",
    "spike:sp-1": "node spikes/serve.mjs spikes/sp-1 4200",
    "spike:sp-3": "node spikes/sp-3/build.mjs && node spikes/serve.mjs spikes/sp-3/dist 4200",
    "spike:sp-4": "node spikes/serve.mjs spikes/sp-4 4200",
    "spike:sp-5": "node spikes/sp-5/build.mjs && node spikes/serve.mjs spikes/sp-5/dist 4200",
    "spike:sp-6": "node spikes/sp-6/build.mjs && node spikes/sp-6/server.mjs 4200",
    "audit": "npm audit --audit-level=high",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:deployed": "playwright test -c playwright.deployed.config.ts",
    "e2e:visual": "playwright test -c playwright.visual.config.ts",
    "e2e:visual:docker": "node scripts/visual-docker.mjs",
    "e2e:install": "playwright install chromium firefox webkit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/html": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "vitest-browser-react": "^2.3.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "yaml": "^2.9.1"
  }
}
